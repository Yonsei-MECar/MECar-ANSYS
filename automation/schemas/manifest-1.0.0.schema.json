{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mecar.local/schemas/analysis-manifest-1.0.0.json",
  "title": "MECar Analysis Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "profile", "adapter", "timeout_sec"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "submission_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
      }
    },
    "adapter": {"enum": ["dummy", "mapdl_v211", "fluent_v211"]},
    "timeout_sec": {"type": "number", "minimum": 0.05, "maximum": 604800},
    "parameters": {"type": "object"},
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "licenses": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipients": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "format": "email"}
        }
      }
    }
  }
}

