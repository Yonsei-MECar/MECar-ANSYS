{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mecar.local/schemas/analysis-profile-1.0.0.json",
  "title": "MECar Analysis Profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "profile_id", "version", "adapter", "enabled", "settings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "adapter": {"enum": ["dummy", "mapdl_v211", "fluent_v211"]},
    "enabled": {"type": "boolean"},
    "ansys_release": {"type": "string"},
    "external_execution_enabled": {"type": "boolean"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_mb", "licenses"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "licenses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_input": {"type": "string", "minLength": 1},
        "approved_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_assets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "sha256"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "mandatory_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "dimension_precision": {"enum": ["2ddp", "3ddp"]},
        "max_timeout_sec": {"type": "number", "minimum": 0.05, "maximum": 604800}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"adapter": {"enum": ["mapdl_v211", "fluent_v211"]}}},
      "then": {
        "required": ["ansys_release", "external_execution_enabled", "resources"],
        "properties": {
          "ansys_release": {"const": "211"},
          "settings": {
            "required": [
              "executable",
              "executable_sha256",
              "approved_input",
              "approved_input_sha256",
              "mandatory_outputs",
              "max_timeout_sec"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"adapter": {"const": "fluent_v211"}}},
      "then": {"properties": {"settings": {"required": ["dimension_precision"]}}}
    }
  ]
}
