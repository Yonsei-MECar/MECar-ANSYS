# Python environments, caches, coverage and packages
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.py[cod]
**/*.egg-info/
**/.coverage
**/coverage.xml
**/htmlcov/
**/build/
**/dist/

# Editors and operating-system state
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Local configuration and credentials. Keep only explicitly named examples.
**/.env
**/.env.*
!**/.env.example
!**/*.env.example
**/*.local.json
**/*.local.toml
**/app.json
**/config.toml
**/smtp.json
**/secrets/
**/credentials/
**/*credentials*.json
**/*service-account*.json
**/.ssh/
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.kdbx

# ANSYS licensing, host and relay configuration
**/ansyslmd.ini
**/ansysli_client_settings.conf
**/license.dat
**/*.lic
**/lmutil*
**/lmstat*
**/rat-hole*.toml
**/rathole*.toml
**/hosts
**/hosts.local

# Solver runtime directories and artifact stores
local-inputs/
**/runtime/
**/results/
**/work/
**/scratch/
**/runs/
**/cases/
**/artifacts/
**/reports/
**/logs/
**/hotfolder/
**/archive/
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal

# Workbench, Fluent and MAPDL generated files
**/*.wbpj
**/*.wbpz
**/*.mechdb
**/*.mechdat
**/*.agdb
**/*.db
**/*.msh
**/*.msh.h5
**/*.mesh
**/*.unv
**/*.neu
**/*.nas
**/*.bdf
**/*.cas
**/*.cas.gz
**/*.cas.h5
**/*.dat.h5
**/*.cdat
**/*.cgns
**/*.trn
**/*.flprj
**/*.flprz
**/*.cffdb
**/*.rst
**/*.rth
**/*.rmg
**/*.emat
**/*.esav
**/*.full
**/*.mode
**/*.mntr
**/*.page
**/*.dsub
**/*.sub
**/*.out
**/*.err
**/*.log

# CAD and proprietary geometry. Text manifests and approved source scripts remain trackable.
**/*.step
**/*.stp
**/*.iges
**/*.igs
**/*.x_t
**/*.x_b
**/*.sat
**/*.parasolid
**/*.sldprt
**/*.sldasm
**/*.catpart
**/*.catproduct
**/*.3dm
**/*.stl
**/*.obj
**/*.ply
**/*.fcstd
**/*.dwg
**/*.dxf

# Explicit test fixtures are reviewed public inputs, not runtime artifacts.
!**/tests/fixtures/**

# Re-apply generated-code exclusions after the fixture exception above.
**/tests/fixtures/**/__pycache__/
**/tests/fixtures/**/*.py[cod]
